{
  "name": "personal-wealth-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:build": "npm run icons:build && npm run vendor:build",
    "build": "node scripts/build-site.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "vendor:build": "node scripts/build-vendor.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "node scripts/check.mjs",
    "format:check": "node scripts/check-format.mjs",
    "ui:check": "node scripts/check-ui.mjs",
    "test": "node tests/run-tests.mjs",
    "test:lifecycle": "node scripts/account-lifecycle-smoke.mjs",
    "test:rls": "node scripts/rls-isolation-smoke.mjs",
    "test:session": "node scripts/session-security-smoke.mjs",
    "test:settings": "node scripts/profile-settings-smoke.mjs",
    "test:settings-ui": "node scripts/settings-ui-smoke.mjs",
    "test:build": "node scripts/build-smoke.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "verify": "npm run lint && npm run format:check && npm run ui:check && npm test && npm run test:build && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "chart.js": "^4.5.1",
    "lucide": "^1.33.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "playwright-core": "^1.62.1"
  }
}
